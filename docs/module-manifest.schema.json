{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:notchy:module-manifest:v2",
  "title": "Notchy declarative module manifest v2",
  "description": "Installable local modules rendered by the host. No code, HTML, CSS, endpoints, assets or privileged permissions. Runtime validation also checks references and bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "version", "name", "description", "permissions", "fields", "actions", "presentations", "appearance"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 512},
    "manifestVersion": {"const": 2},
    "id": {"type": "string", "maxLength": 96, "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*){1,3}$"},
    "version": {"type": "string", "pattern": "^(?:0|[1-9]\\d{0,3})\\.(?:0|[1-9]\\d{0,3})\\.(?:0|[1-9]\\d{0,3})$"},
    "name": {"$ref": "#/$defs/label"},
    "description": {"$ref": "#/$defs/description"},
    "permissions": {"type": "array", "maxItems": 0},
    "fields": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/field"}},
    "actions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/action"}},
    "presentations": {
      "type": "object", "additionalProperties": false, "required": ["full", "scene", "rail"],
      "properties": {"full": {"$ref": "#/$defs/presentation"}, "scene": {"$ref": "#/$defs/presentation"}, "rail": {"$ref": "#/$defs/presentation"}}
    },
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["valueField", "targetField", "label"],
      "properties": {"valueField": {"$ref": "#/$defs/identifier"}, "targetField": {"$ref": "#/$defs/identifier"}, "label": {"$ref": "#/$defs/label"}}
    },
    "appearance": {
      "type": "object", "additionalProperties": false, "required": ["accent"],
      "properties": {"accent": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "maxLength": 48, "pattern": "^(?!(?:constructor|prototype)$)[a-z][a-z0-9-]{0,47}$"},
    "label": {
      "type": "object", "additionalProperties": false, "required": ["en", "fr"],
      "properties": {"en": {"$ref": "#/$defs/labelText"}, "fr": {"$ref": "#/$defs/labelText"}}
    },
    "labelText": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])[\\s\\S]*\\S[\\s\\S]*$"},
    "description": {
      "type": "object", "additionalProperties": false, "required": ["en", "fr"],
      "properties": {
        "en": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])[\\s\\S]*\\S[\\s\\S]*$"},
        "fr": {"type": "string", "minLength": 1, "maxLength": 280, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])[\\s\\S]*\\S[\\s\\S]*$"}
      }
    },
    "field": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "default", "min", "max"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "number"}, "label": {"$ref": "#/$defs/label"},
            "default": {"type": "number", "minimum": -1000000, "maximum": 1000000},
            "min": {"type": "number", "minimum": -1000000, "maximum": 1000000},
            "max": {"type": "number", "minimum": -1000000, "maximum": 1000000}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "default"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "text"}, "label": {"$ref": "#/$defs/label"},
            "default": {"type": "string", "maxLength": 512, "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f]*$"},
            "maxLength": {"type": "integer", "minimum": 1, "maximum": 512, "default": 512}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "default"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "type": {"const": "boolean"}, "label": {"$ref": "#/$defs/label"}, "default": {"type": "boolean"}}
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "label", "amount"],
          "properties": {
            "id": {"$ref": "#/$defs/identifier"}, "type": {"const": "increment"}, "field": {"$ref": "#/$defs/identifier"}, "label": {"$ref": "#/$defs/label"},
            "amount": {"type": "number", "minimum": -1000000, "maximum": 1000000, "not": {"const": 0}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "field", "label"],
          "properties": {"id": {"$ref": "#/$defs/identifier"}, "type": {"enum": ["reset", "toggle", "set-text"]}, "field": {"$ref": "#/$defs/identifier"}, "label": {"$ref": "#/$defs/label"}}
        }
      ]
    },
    "presentation": {
      "type": "object", "additionalProperties": false, "required": ["fields", "actions"],
      "properties": {
        "fields": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "actions": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    }
  }
}
