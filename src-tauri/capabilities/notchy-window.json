{
  "identifier": "notchy-window",
  "description": "Événements pour l’unique interface locale Notchy ; aucune commande de shell ou de fichiers générale.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-desktop-command",
    "allow-health-run",
    "allow-settings-get",
    "allow-settings-set",
    "allow-favorites-list",
    "allow-favorites-add",
    "allow-discovery-validate",
    "allow-discovery-scan",
    "allow-discovery-first-candidates"
  ]
}
